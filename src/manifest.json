{
	"manifest_version": 1,
	"id": "io.github.akiratamcat.dg-plantuml",
	"app_min_version": "3.1",
	"version": "1.0.0",
	"name": "dg-plantuml",
	"description": "Render PlantUML diagrams with a bundled engine. No external server, no network access.",
	"author": "akira tamcat",
	"homepage_url": "https://github.com/akiratamcat/joplin-plugin-dg-plantuml",
	"repository_url": "https://github.com/akiratamcat/joplin-plugin-dg-plantuml",
	"platforms": ["desktop"],
	"categories": ["viewer", "editor"],
	"keywords": ["plantuml", "diagram", "uml", "offline"],
	"screenshots": [
		{ "src": "docs/images/screenshot-light.png", "label": "Sequence and class diagrams in a note (light theme)" },
		{ "src": "docs/images/screenshot-dark.png", "label": "The same note in the dark theme" },
		{ "src": "docs/images/screenshot-settings.png", "label": "Settings screen" }
	],
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	}
}
