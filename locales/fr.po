#: src/contentScript/controller.ts:138
msgid "The diagram is too large."
msgstr "Le diagramme est trop grand."

#: src/contentScript/controller.ts:140
msgid "The source has {count} character. The limit is {limit}."
msgid_plural "The source has {count} characters. The limit is {limit}."
msgstr[0] "La source contient {count} caractère. La limite est de {limit}."
msgstr[1] "La source contient {count} caractères. La limite est de {limit}."

#: src/contentScript/controller.ts:198
msgid "Rendering..."
msgstr "Rendu en cours..."

#: src/contentScript/controller.ts:198
msgid "Loading the PlantUML engine..."
msgstr "Chargement du moteur PlantUML..."

#: src/contentScript/controller.ts:295
msgid "Could not load the PlantUML engine."
msgstr "Impossible de charger le moteur PlantUML."

#: src/contentScript/controller.ts:296
msgid "See the developer tools console for details."
msgstr "Consultez la console des outils de développement pour plus de détails."

#: src/contentScript/controller.ts:315
#: src/contentScript/controller.ts:330
msgid "PlantUML error"
msgstr "Erreur PlantUML"

#: src/contentScript/controller.ts:322
msgid "Rendering timed out."
msgstr "Délai de rendu dépassé."

#: src/contentScript/controller.ts:323
msgid "Rendering took longer than {ms} ms."
msgstr "Le rendu a pris plus de {ms} ms."

#: src/contentScript/controller.ts:328
msgid "The PlantUML engine crashed."
msgstr "Le moteur PlantUML a planté."

#: src/contentScript/controller.ts:343
msgid "Only the first diagram in this block is shown."
msgstr "Seul le premier diagramme de ce bloc est affiché."

#: src/contentScript/controller.ts:429
#. {line} is a line number in the diagram source, {message} is the error message of PlantUML (in English).
msgid "Line {line}: {message}"
msgstr "Ligne {line} : {message}"

#: src/settings.ts:107
msgid "Style for the dark theme"
msgstr "Style pour le thème sombre"

#: src/settings.ts:108
msgid "Used on a dark note viewer. Light colours on a dark page are hard to read."
msgstr "Utilisé lorsque la visionneuse de notes est sombre. Les couleurs claires sont difficiles à lire sur une page sombre."

#: src/settings.ts:115
msgid "Transparent diagram background"
msgstr "Arrière-plan du diagramme transparent"

#: src/settings.ts:122
msgid "Match the font size of the note"
msgstr "Suivre la taille de police de la note"

#: src/settings.ts:123
msgid "Uses the font size of the note text as the base font size of diagrams."
msgstr "Utilise la taille de police du texte de la note comme taille de base des diagrammes."

#: src/settings.ts:133
msgid "Minimum font size when scaled down (px)"
msgstr "Taille de police minimale lors de la réduction (px)"

#: src/settings.ts:134
msgid "Wide diagrams are not scaled down below this font size; they scroll sideways instead. 0: no limit."
msgstr "Les diagrammes larges ne sont pas réduits en dessous de cette taille de police ; ils défilent horizontalement à la place. 0 : aucune limite."

#: src/settings.ts:142
msgid "Custom preamble for the light theme"
msgstr "Préambule personnalisé pour le thème clair"

#: src/settings.ts:144
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the light style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Utilisé lorsque le style du thème clair est « Personnalisé (préambule ci-dessous) ». Lignes PlantUML ajoutées après @startuml. Écrivez \\n"
" entre les lignes."

#: src/settings.ts:152
msgid "Custom preamble for the dark theme"
msgstr "Préambule personnalisé pour le thème sombre"

#: src/settings.ts:154
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the dark style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Utilisé lorsque le style du thème sombre est « Personnalisé (préambule ci-dessous) ». Lignes PlantUML ajoutées après @startuml. Écrivez \\n"
" entre les lignes."

#: src/settings.ts:162
msgid "Font used in diagrams"
msgstr "Police utilisée dans les diagrammes"

#: src/settings.ts:163
msgid "Name of the font used in diagrams. Empty: the default font."
msgstr "Nom de la police utilisée dans les diagrammes. Vide : police par défaut."

#: src/settings.ts:171
msgid "Other language names"
msgstr "Autres noms de langage"

#: src/settings.ts:173
#. The info string is the text right after the opening fence of a code block, as in ```plantuml. "plantuml" and "puml" are language names and are not translated.
msgid "Info strings (language names) of code fences that are drawn as PlantUML diagrams. Separate several language names with commas. \"plantuml\" and \"puml\" always work."
msgstr "Chaînes d'information (noms de langage) des blocs de code délimités qui sont dessinés comme diagrammes PlantUML. Séparez plusieurs noms de langage par des virgules. « plantuml » et « puml » fonctionnent toujours."

#: src/settings.ts:184
msgid "Time limit per diagram (ms)"
msgstr "Durée maximale par diagramme (ms)"

#: src/settings.ts:195
msgid "Maximum source length (characters)"
msgstr "Longueur maximale de la source (caractères)"

#: src/settings.ts:206
msgid "Number of diagrams held in the cache"
msgstr "Nombre de diagrammes conservés en cache"

#: src/settings.ts:219
msgid "A plugin that renders PlantUML. The PlantUML rendering engine is built in, and the plugin makes no network connections to the outside."
msgstr "Un plugin qui affiche les diagrammes PlantUML. Le moteur de rendu PlantUML est intégré, et le plugin n'établit aucune connexion réseau vers l'extérieur."

#: src/settings.ts:33
#. {name} is the name of a built-in PlantUML theme, for example "Cyborg". Theme names are not translated.
msgid "PlantUML theme: {name}"
msgstr "Thème PlantUML : {name}"

#: src/settings.ts:45
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours, default)"
msgstr "PlantUML standard (couleurs claires, par défaut)"

#: src/settings.ts:47
#. Name of a diagram style. "Joplin" is not translated.
msgid "Joplin light (light colours)"
msgstr "Joplin clair (couleurs claires)"

#: src/settings.ts:49
#: src/settings.ts:61
msgid "Custom (preamble below)"
msgstr "Personnalisé (préambule ci-dessous)"

#: src/settings.ts:57
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML dark (dark colours, default)"
msgstr "PlantUML sombre (couleurs sombres, par défaut)"

#: src/settings.ts:59
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours)"
msgstr "PlantUML standard (couleurs claires)"

#: src/settings.ts:81
msgid "Auto (follow Joplin's theme)"
msgstr "Automatique (suivre le thème de Joplin)"

#: src/settings.ts:87
msgid "PlantUML diagram theme"
msgstr "Thème des diagrammes PlantUML"

#: src/settings.ts:88
msgid "When set to \"Auto\", the light or dark style is chosen automatically from the background of the note viewer."
msgstr "Avec « Automatique », le style clair ou sombre est choisi automatiquement selon l'arrière-plan de la visionneuse de notes."

#: src/settings.ts:97
msgid "Style for the light theme"
msgstr "Style pour le thème clair"

#: src/settings.ts:98
msgid "Used on a light note viewer. Dark colours on a light page are hard to read."
msgstr "Utilisé lorsque la visionneuse de notes est claire. Les couleurs sombres sont difficiles à lire sur une page claire."

#: src/settings.ts:83
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Light"
msgstr "Clair"

#: src/settings.ts:85
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Dark"
msgstr "Sombre"
