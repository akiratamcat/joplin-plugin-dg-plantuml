msgstr "Impossible d'enregistrer : {error}"

#: src/actions.ts:138
msgid "This link cannot be opened: {href}"
msgstr "Ce lien ne peut pas être ouvert : {href}"

#: src/actions.ts:84
msgid "Copied the SVG."
msgstr "SVG copié."

#: src/actions.ts:84
