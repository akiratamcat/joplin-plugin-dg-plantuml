#: src/actions.ts:129
msgid "Saved: {path}"
msgstr "Сохранено: {path}"

#: src/actions.ts:132
msgid "Could not save: {error}"
msgstr "Не удалось сохранить: {error}"

#: src/actions.ts:138
msgid "This link cannot be opened: {href}"
msgstr "Эту ссылку нельзя открыть: {href}"

#: src/actions.ts:84
msgid "Copied the SVG."
msgstr "SVG скопирован."

#: src/actions.ts:84
msgid "Copied the PlantUML source."
msgstr "Исходный текст PlantUML скопирован."

#: src/actions.ts:87
#: src/actions.ts:100
msgid "Could not copy: {error}"
msgstr "Не удалось скопировать: {error}"

#: src/actions.ts:97
msgid "Copied the image (PNG)."
msgstr "Изображение (PNG) скопировано."

#: src/contentScript/controller.ts:146
msgid "The diagram is too large."
msgstr "Диаграмма слишком большая."

#: src/contentScript/controller.ts:148
msgid "The source has {count} character. The limit is {limit}."
msgid_plural "The source has {count} characters. The limit is {limit}."
msgstr[0] "Исходный текст содержит {count} символ. Ограничение — {limit}."
msgstr[1] "Исходный текст содержит {count} символа. Ограничение — {limit}."
msgstr[2] "Исходный текст содержит {count} символов. Ограничение — {limit}."

#: src/contentScript/controller.ts:206
msgid "Rendering..."
msgstr "Отрисовка..."

#: src/contentScript/controller.ts:206
msgid "Loading the PlantUML engine..."
msgstr "Загрузка движка PlantUML..."

#: src/contentScript/controller.ts:314
msgid "Could not load the PlantUML engine."
msgstr "Не удалось загрузить движок PlantUML."

#: src/contentScript/controller.ts:315
msgid "See the developer tools console for details."
msgstr "Подробности смотрите в консоли инструментов разработчика."

#: src/contentScript/controller.ts:334
#: src/contentScript/controller.ts:349
msgid "PlantUML error"
msgstr "Ошибка PlantUML"

#: src/contentScript/controller.ts:341
msgid "Rendering timed out."
msgstr "Время отрисовки истекло."

#: src/contentScript/controller.ts:342
msgid "Rendering took longer than {ms} ms."
msgstr "Отрисовка заняла больше {ms} мс."

#: src/contentScript/controller.ts:347
msgid "The PlantUML engine crashed."
msgstr "Движок PlantUML аварийно завершил работу."

#: src/contentScript/controller.ts:362
msgid "PlantUML diagram"
msgstr "Диаграмма PlantUML"

#: src/contentScript/controller.ts:369
msgid "Only the first diagram in this block is shown."
msgstr "Показана только первая диаграмма в этом блоке."

#: src/contentScript/controller.ts:455
#. {line} is a line number in the diagram source, {message} is the error message of PlantUML (in English).
msgid "Line {line}: {message}"
msgstr "Строка {line}: {message}"

#: src/contentScript/toolbar.ts:50
msgid "Diagram tools"
msgstr "Инструменты диаграммы"

#: src/contentScript/toolbar.ts:52
msgid "Copy SVG"
msgstr "Копировать SVG"

#: src/contentScript/toolbar.ts:53
msgid "Copy PNG"
msgstr "Копировать PNG"

#: src/contentScript/toolbar.ts:54
msgid "Save SVG"
msgstr "Сохранить SVG"

#: src/contentScript/toolbar.ts:55
msgid "Save PNG"
msgstr "Сохранить PNG"

#: src/contentScript/toolbar.ts:56
msgid "Copy PlantUML source"
msgstr "Копировать исходный текст PlantUML"

#: src/index.ts:61
msgid "Choose a folder to save the diagram in"
msgstr "Выберите папку для сохранения диаграммы"

#: src/settings.ts:101
msgid "Style for the light theme"
msgstr "Стиль для светлой темы"

#: src/settings.ts:102
msgid "Used on a light note viewer. Dark colours on a light page are hard to read."
msgstr "Используется, когда просмотр заметки светлый. Тёмные цвета плохо читаются на светлой странице."

#: src/settings.ts:111
msgid "Style for the dark theme"
msgstr "Стиль для тёмной темы"

#: src/settings.ts:112
msgid "Used on a dark note viewer. Light colours on a dark page are hard to read."
msgstr "Используется, когда просмотр заметки тёмный. Светлые цвета плохо читаются на тёмной странице."

#: src/settings.ts:119
msgid "Transparent diagram background"
msgstr "Прозрачный фон диаграммы"

#: src/settings.ts:126
msgid "Show the diagram toolbar"
msgstr "Показывать панель инструментов диаграммы"

#: src/settings.ts:127
msgid "Buttons to copy or save a diagram, shown when the mouse is over it or after a tap on it."
msgstr "Кнопки для копирования или сохранения диаграммы; появляются при наведении мыши на диаграмму или после касания."

#: src/settings.ts:134
msgid "Match the font size of the note"
msgstr "Размер шрифта как в заметке"

#: src/settings.ts:135
msgid "Uses the font size of the note text as the base font size of diagrams."
msgstr "Использует размер шрифта текста заметки как базовый размер шрифта диаграмм."

#: src/settings.ts:145
msgid "Minimum font size when scaled down (px)"
msgstr "Минимальный размер шрифта при уменьшении (px)"

#: src/settings.ts:146
msgid "Wide diagrams are not scaled down below this font size; they scroll sideways instead. 0: no limit."
msgstr "Широкие диаграммы не уменьшаются ниже этого размера шрифта; вместо этого они прокручиваются по горизонтали. 0 — без ограничения."

#: src/settings.ts:153
msgid "Highlight PlantUML in the Markdown editor"
msgstr "Подсвечивать PlantUML в редакторе Markdown"

#: src/settings.ts:154
msgid "Colours the PlantUML code in the Markdown editor. A change applies when the note is opened again."
msgstr "Раскрашивает код PlantUML в редакторе Markdown. Изменение вступает в силу при повторном открытии заметки."

#: src/settings.ts:162
msgid "Custom preamble for the light theme"
msgstr "Своя преамбула для светлой темы"

#: src/settings.ts:164
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the light style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Используется, когда стиль светлой темы — «Свой (преамбула ниже)». Строки PlantUML, добавляемые после @startuml. Пишите \\n"
" между строками."

#: src/settings.ts:172
msgid "Custom preamble for the dark theme"
msgstr "Своя преамбула для тёмной темы"

#: src/settings.ts:174
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the dark style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Используется, когда стиль тёмной темы — «Свой (преамбула ниже)». Строки PlantUML, добавляемые после @startuml. Пишите \\n"
" между строками."

#: src/settings.ts:182
msgid "Font used in diagrams"
msgstr "Шрифт, используемый в диаграммах"

#: src/settings.ts:183
msgid "Name of the font used in diagrams. Empty: the default font."
msgstr "Название шрифта, используемого в диаграммах. Пусто — шрифт по умолчанию."

#: src/settings.ts:191
msgid "Other language names"
msgstr "Другие названия языков"

#: src/settings.ts:193
#. The info string is the text right after the opening fence of a code block, as in ```plantuml. "plantuml" and "puml" are language names and are not translated.
msgid "Info strings (language names) of code fences that are drawn as PlantUML diagrams. Separate several language names with commas. \"plantuml\" and \"puml\" always work."
msgstr "Информационные строки (названия языков) блоков кода, которые рисуются как диаграммы PlantUML. Несколько названий языков разделяйте запятыми. «plantuml» и «puml» работают всегда."

#: src/settings.ts:204
msgid "Time limit per diagram (ms)"
msgstr "Ограничение времени на диаграмму (мс)"

#: src/settings.ts:215
msgid "Maximum source length (characters)"
msgstr "Максимальная длина исходного текста (символов)"

#: src/settings.ts:226
msgid "Number of diagrams held in the cache"
msgstr "Количество диаграмм, хранимых в кэше"

#: src/settings.ts:239
msgid "Bundled third-party software"
msgstr "Встроенное стороннее ПО"

#: src/settings.ts:240
msgid "Open the list to see the name, version, license and website of each component. Choosing an item changes nothing. The full license texts are in THIRD_PARTY_NOTICES.md in the plugin package."
msgstr "Откройте список, чтобы увидеть название, версию, лицензию и сайт каждого компонента. Выбор пункта ничего не меняет. Полные тексты лицензий — в файле THIRD_PARTY_NOTICES.md в пакете плагина."

#: src/settings.ts:253
msgid "A plugin that renders PlantUML. The PlantUML rendering engine is built in, and the plugin makes no network connections to the outside."
msgstr "Плагин для отрисовки PlantUML. Движок отрисовки PlantUML встроен, и плагин не устанавливает сетевых соединений с внешним миром."

#: src/settings.ts:37
#. {name} is the name of a built-in PlantUML theme, for example "Cyborg". Theme names are not translated.
msgid "PlantUML theme: {name}"
msgstr "Тема PlantUML: {name}"

#: src/settings.ts:49
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours, default)"
msgstr "PlantUML стандартный (светлые цвета, по умолчанию)"

#: src/settings.ts:51
#. Name of a diagram style. "Joplin" is not translated.
msgid "Joplin light (light colours)"
msgstr "Joplin светлый (светлые цвета)"

#: src/settings.ts:53
#: src/settings.ts:65
msgid "Custom (preamble below)"
msgstr "Свой (преамбула ниже)"

#: src/settings.ts:61
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML dark (dark colours, default)"
msgstr "PlantUML тёмный (тёмные цвета, по умолчанию)"

#: src/settings.ts:63
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours)"
msgstr "PlantUML стандартный (светлые цвета)"

#: src/settings.ts:85
msgid "Auto (follow Joplin's theme)"
msgstr "Авто (как тема Joplin)"

#: src/settings.ts:91
msgid "PlantUML diagram theme"
msgstr "Тема диаграмм PlantUML"

#: src/settings.ts:92
msgid "When set to \"Auto\", the light or dark style is chosen automatically from the background of the note viewer."
msgstr "В режиме «Авто» светлый или тёмный стиль выбирается автоматически по фону просмотра заметки."

#: src/settings.ts:87
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Light"
msgstr "Светлая"

#: src/settings.ts:89
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Dark"
msgstr "Тёмная"
