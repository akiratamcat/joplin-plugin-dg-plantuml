#: src/actions.ts:129
msgid "Saved: {path}"
msgstr "Salvato: {path}"

#: src/actions.ts:132
msgid "Could not save: {error}"
msgstr "Impossibile salvare: {error}"

#: src/actions.ts:138
msgid "This link cannot be opened: {href}"
msgstr "Questo link non può essere aperto: {href}"

#: src/actions.ts:84
msgid "Copied the SVG."
msgstr "SVG copiato."

#: src/actions.ts:84
msgid "Copied the PlantUML source."
msgstr "Sorgente PlantUML copiato."

#: src/actions.ts:87
#: src/actions.ts:100
msgid "Could not copy: {error}"
msgstr "Impossibile copiare: {error}"

#: src/actions.ts:97
msgid "Copied the image (PNG)."
msgstr "Immagine (PNG) copiata."

#: src/contentScript/controller.ts:146
msgid "The diagram is too large."
msgstr "Il diagramma è troppo grande."

#: src/contentScript/controller.ts:148
msgid "The source has {count} character. The limit is {limit}."
msgid_plural "The source has {count} characters. The limit is {limit}."
msgstr[0] "Il sorgente ha {count} carattere. Il limite è {limit}."
msgstr[1] "Il sorgente ha {count} caratteri. Il limite è {limit}."

#: src/contentScript/controller.ts:206
msgid "Rendering..."
msgstr "Rendering in corso..."

#: src/contentScript/controller.ts:206
msgid "Loading the PlantUML engine..."
msgstr "Caricamento del motore PlantUML..."

#: src/contentScript/controller.ts:314
msgid "Could not load the PlantUML engine."
msgstr "Impossibile caricare il motore PlantUML."

#: src/contentScript/controller.ts:315
msgid "See the developer tools console for details."
msgstr "Per i dettagli, consulta la console degli strumenti per sviluppatori."

#: src/contentScript/controller.ts:334
#: src/contentScript/controller.ts:349
msgid "PlantUML error"
msgstr "Errore di PlantUML"

#: src/contentScript/controller.ts:341
msgid "Rendering timed out."
msgstr "Tempo di rendering scaduto."

#: src/contentScript/controller.ts:342
msgid "Rendering took longer than {ms} ms."
msgstr "Il rendering ha richiesto più di {ms} ms."

#: src/contentScript/controller.ts:347
msgid "The PlantUML engine crashed."
msgstr "Il motore PlantUML si è arrestato in modo anomalo."

#: src/contentScript/controller.ts:362
msgid "PlantUML diagram"
msgstr "Diagramma PlantUML"

#: src/contentScript/controller.ts:369
msgid "Only the first diagram in this block is shown."
msgstr "Viene mostrato solo il primo diagramma di questo blocco."

#: src/contentScript/controller.ts:455
#. {line} is a line number in the diagram source, {message} is the error message of PlantUML (in English).
msgid "Line {line}: {message}"
msgstr "Riga {line}: {message}"

#: src/contentScript/toolbar.ts:50
msgid "Diagram tools"
msgstr "Strumenti del diagramma"

#: src/contentScript/toolbar.ts:52
msgid "Copy SVG"
msgstr "Copia SVG"

#: src/contentScript/toolbar.ts:53
msgid "Copy PNG"
msgstr "Copia PNG"

#: src/contentScript/toolbar.ts:54
msgid "Save SVG"
msgstr "Salva SVG"

#: src/contentScript/toolbar.ts:55
msgid "Save PNG"
msgstr "Salva PNG"

#: src/contentScript/toolbar.ts:56
msgid "Copy PlantUML source"
msgstr "Copia il sorgente PlantUML"

#: src/index.ts:61
msgid "Choose a folder to save the diagram in"
msgstr "Scegli la cartella in cui salvare il diagramma"

#: src/settings.ts:100
msgid "Style for the light theme"
msgstr "Stile per il tema chiaro"

#: src/settings.ts:101
msgid "Used on a light note viewer. Dark colours on a light page are hard to read."
msgstr "Usato quando il visualizzatore delle note è chiaro. I colori scuri sono difficili da leggere su una pagina chiara."

#: src/settings.ts:110
msgid "Style for the dark theme"
msgstr "Stile per il tema scuro"

#: src/settings.ts:111
msgid "Used on a dark note viewer. Light colours on a dark page are hard to read."
msgstr "Usato quando il visualizzatore delle note è scuro. I colori chiari sono difficili da leggere su una pagina scura."

#: src/settings.ts:118
msgid "Transparent diagram background"
msgstr "Sfondo del diagramma trasparente"

#: src/settings.ts:125
msgid "Show the diagram toolbar"
msgstr "Mostra la barra degli strumenti del diagramma"

#: src/settings.ts:126
msgid "Buttons to copy or save a diagram, shown when the mouse is over it or after a tap on it."
msgstr "Pulsanti per copiare o salvare un diagramma, mostrati quando il mouse è sopra di esso o dopo averlo toccato."

#: src/settings.ts:133
msgid "Match the font size of the note"
msgstr "Usa la dimensione del carattere della nota"

#: src/settings.ts:134
msgid "Uses the font size of the note text as the base font size of diagrams."
msgstr "Usa la dimensione del carattere del testo della nota come dimensione di base dei diagrammi."

#: src/settings.ts:144
msgid "Minimum font size when scaled down (px)"
msgstr "Dimensione minima del carattere quando ridotto (px)"

#: src/settings.ts:145
msgid "Wide diagrams are not scaled down below this font size; they scroll sideways instead. 0: no limit."
msgstr "I diagrammi larghi non vengono ridotti sotto questa dimensione del carattere; scorrono invece in orizzontale. 0: nessun limite."

#: src/settings.ts:152
msgid "Highlight PlantUML in the Markdown editor"
msgstr "Evidenzia PlantUML nell'editor Markdown"

#: src/settings.ts:153
msgid "Colours the PlantUML code in the Markdown editor. A change applies when the note is opened again."
msgstr "Colora il codice PlantUML nell'editor Markdown. Una modifica ha effetto quando la nota viene riaperta."

#: src/settings.ts:161
msgid "Custom preamble for the light theme"
msgstr "Preambolo personalizzato per il tema chiaro"

#: src/settings.ts:163
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the light style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Usato quando lo stile del tema chiaro è «Personalizzato (preambolo sotto)». Righe PlantUML aggiunte dopo @startuml. Scrivi \\n"
" tra le righe."

#: src/settings.ts:171
msgid "Custom preamble for the dark theme"
msgstr "Preambolo personalizzato per il tema scuro"

#: src/settings.ts:173
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the dark style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Usato quando lo stile del tema scuro è «Personalizzato (preambolo sotto)». Righe PlantUML aggiunte dopo @startuml. Scrivi \\n"
" tra le righe."

#: src/settings.ts:181
msgid "Font used in diagrams"
msgstr "Carattere usato nei diagrammi"

#: src/settings.ts:182
msgid "Name of the font used in diagrams. Empty: the default font."
msgstr "Nome del carattere usato nei diagrammi. Vuoto: il carattere predefinito."

#: src/settings.ts:190
msgid "Other language names"
msgstr "Altri nomi di linguaggio"

#: src/settings.ts:192
#. The info string is the text right after the opening fence of a code block, as in ```plantuml. "plantuml" and "puml" are language names and are not translated.
msgid "Info strings (language names) of code fences that are drawn as PlantUML diagrams. Separate several language names with commas. \"plantuml\" and \"puml\" always work."
msgstr "Stringhe informative (nomi di linguaggio) dei blocchi di codice delimitati che vengono disegnati come diagrammi PlantUML. Separa più nomi di linguaggio con virgole. \"plantuml\" e \"puml\" funzionano sempre."

#: src/settings.ts:203
msgid "Time limit per diagram (ms)"
msgstr "Tempo massimo per diagramma (ms)"

#: src/settings.ts:214
msgid "Maximum source length (characters)"
msgstr "Lunghezza massima del sorgente (caratteri)"

#: src/settings.ts:225
msgid "Number of diagrams held in the cache"
msgstr "Numero di diagrammi conservati nella cache"

#: src/settings.ts:239
msgid "A plugin that renders PlantUML. The PlantUML rendering engine is built in, and the plugin makes no network connections to the outside."
msgstr "Un plugin che genera diagrammi PlantUML. Il motore di rendering di PlantUML è integrato e il plugin non stabilisce connessioni di rete verso l'esterno."

#: src/settings.ts:242
#. Followed by a list of name, version, license and website of each component.
msgid "Bundled third-party software (full license texts: THIRD_PARTY_NOTICES.md in the plugin package):"
msgstr "Software di terze parti incluso (testi completi delle licenze: THIRD_PARTY_NOTICES.md nel pacchetto del plugin):"

#: src/settings.ts:36
#. {name} is the name of a built-in PlantUML theme, for example "Cyborg". Theme names are not translated.
msgid "PlantUML theme: {name}"
msgstr "Tema PlantUML: {name}"

#: src/settings.ts:48
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours, default)"
msgstr "PlantUML standard (colori chiari, predefinito)"

#: src/settings.ts:50
#. Name of a diagram style. "Joplin" is not translated.
msgid "Joplin light (light colours)"
msgstr "Joplin chiaro (colori chiari)"

#: src/settings.ts:52
#: src/settings.ts:64
msgid "Custom (preamble below)"
msgstr "Personalizzato (preambolo sotto)"

#: src/settings.ts:60
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML dark (dark colours, default)"
msgstr "PlantUML scuro (colori scuri, predefinito)"

#: src/settings.ts:62
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours)"
msgstr "PlantUML standard (colori chiari)"

#: src/settings.ts:84
msgid "Auto (follow Joplin's theme)"
msgstr "Automatico (segue il tema di Joplin)"

#: src/settings.ts:90
msgid "PlantUML diagram theme"
msgstr "Tema dei diagrammi PlantUML"

#: src/settings.ts:91
msgid "When set to \"Auto\", the light or dark style is chosen automatically from the background of the note viewer."
msgstr "Con «Automatico», lo stile chiaro o scuro viene scelto automaticamente in base allo sfondo del visualizzatore delle note."

#: src/settings.ts:86
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Light"
msgstr "Chiaro"

#: src/settings.ts:88
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Dark"
msgstr "Scuro"
