#: src/contentScript/controller.ts:138
msgid "The diagram is too large."
msgstr "Das Diagramm ist zu groß."

#: src/contentScript/controller.ts:140
msgid "The source has {count} character. The limit is {limit}."
msgid_plural "The source has {count} characters. The limit is {limit}."
msgstr[0] "Der Quelltext hat {count} Zeichen. Die Grenze liegt bei {limit}."
msgstr[1] "Der Quelltext hat {count} Zeichen. Die Grenze liegt bei {limit}."

#: src/contentScript/controller.ts:198
msgid "Rendering…"
msgstr "Wird gerendert…"

#: src/contentScript/controller.ts:198
msgid "Loading the PlantUML engine…"
msgstr "PlantUML-Engine wird geladen…"

#: src/contentScript/controller.ts:295
msgid "Could not load the PlantUML engine."
msgstr "Die PlantUML-Engine konnte nicht geladen werden."

#: src/contentScript/controller.ts:296
msgid "See the developer tools console for details."
msgstr "Details finden Sie in der Konsole der Entwicklerwerkzeuge."

#: src/contentScript/controller.ts:315
#: src/contentScript/controller.ts:330
msgid "PlantUML error"
msgstr "PlantUML-Fehler"

#: src/contentScript/controller.ts:322
msgid "Rendering timed out."
msgstr "Zeitüberschreitung beim Rendern."

#: src/contentScript/controller.ts:323
msgid "Rendering took longer than {ms} ms."
msgstr "Das Rendern hat länger als {ms} ms gedauert."

#: src/contentScript/controller.ts:328
msgid "The PlantUML engine crashed."
msgstr "Die PlantUML-Engine ist abgestürzt."

#: src/contentScript/controller.ts:343
msgid "Only the first diagram in this block is shown."
msgstr "Nur das erste Diagramm in diesem Block wird angezeigt."

#: src/contentScript/controller.ts:429
#. {line} is a line number in the diagram source, {message} is the error message of PlantUML (in English).
msgid "Line {line}: {message}"
msgstr "Zeile {line}: {message}"

#: src/settings.ts:107
msgid "Style for the dark theme"
msgstr "Stil für das dunkle Design"

#: src/settings.ts:108
msgid "Used on a dark note viewer. Light colours on a dark page are hard to read."
msgstr "Wird bei dunkler Notizansicht verwendet. Helle Farben sind auf einer dunklen Seite schwer zu lesen."

#: src/settings.ts:115
msgid "Transparent diagram background"
msgstr "Transparenter Diagrammhintergrund"

#: src/settings.ts:122
msgid "Match the font size of the note"
msgstr "Schriftgröße der Notiz übernehmen"

#: src/settings.ts:123
msgid "Uses the font size of the note text as the base font size of diagrams."
msgstr "Verwendet die Schriftgröße des Notiztextes als Grundschriftgröße der Diagramme."

#: src/settings.ts:133
msgid "Minimum font size when scaled down (px)"
msgstr "Minimale Schriftgröße beim Verkleinern (px)"

#: src/settings.ts:134
msgid "Wide diagrams are not scaled down below this font size; they scroll sideways instead. 0: no limit."
msgstr "Breite Diagramme werden nicht unter diese Schriftgröße verkleinert; stattdessen wird horizontal gescrollt. 0: keine Grenze."

#: src/settings.ts:142
msgid "Custom preamble for the light theme"
msgstr "Eigene Präambel für das helle Design"

#: src/settings.ts:144
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the light style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Wird verwendet, wenn der Stil für das helle Design „Eigene (Präambel unten)“ ist. PlantUML-Zeilen, die nach @startuml eingefügt werden. Schreiben Sie \\n"
" zwischen die Zeilen."

#: src/settings.ts:152
msgid "Custom preamble for the dark theme"
msgstr "Eigene Präambel für das dunkle Design"

#: src/settings.ts:154
#. "@startuml" and "\n" are written as they are. "\n" is a backslash followed by the letter n.
msgid ""
"Used when the dark style is \"Custom\". PlantUML lines added after @startuml. Write \\n"
" between lines."
msgstr ""
"Wird verwendet, wenn der Stil für das dunkle Design „Eigene (Präambel unten)“ ist. PlantUML-Zeilen, die nach @startuml eingefügt werden. Schreiben Sie \\n"
" zwischen die Zeilen."

#: src/settings.ts:162
msgid "Diagram font"
msgstr "Diagrammschrift"

#: src/settings.ts:163
msgid "Font name for diagrams. Empty: the default font."
msgstr "Schriftname für Diagramme. Leer: Standardschrift."

#: src/settings.ts:171
msgid "Other language names"
msgstr "Weitere Sprachnamen"

#: src/settings.ts:173
#. "plantuml" and "puml" are language names of code blocks and are not translated.
msgid "Code block languages that are also drawn as PlantUML, separated by commas. \"plantuml\" and \"puml\" always work."
msgstr "Sprachen von Codeblöcken, die ebenfalls als PlantUML gezeichnet werden, durch Kommas getrennt. \"plantuml\" und \"puml\" funktionieren immer."

#: src/settings.ts:184
msgid "Time limit per diagram (ms)"
msgstr "Zeitlimit pro Diagramm (ms)"

#: src/settings.ts:195
msgid "Maximum source length (characters)"
msgstr "Maximale Länge des Quelltextes (Zeichen)"

#: src/settings.ts:206
msgid "Number of diagrams kept in the cache"
msgstr "Anzahl der Diagramme im Cache"

#: src/settings.ts:219
msgid "PlantUML diagrams, rendered by the engine bundled in this plugin. No network access."
msgstr "PlantUML-Diagramme, gerendert mit der in diesem Plugin enthaltenen Engine. Kein Netzwerkzugriff."

#: src/settings.ts:33
#. {name} is the name of a built-in PlantUML theme, for example "Cyborg". Theme names are not translated.
msgid "PlantUML theme: {name}"
msgstr "PlantUML-Design: {name}"

#: src/settings.ts:45
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours, default)"
msgstr "PlantUML-Standard (helle Farben, Standard)"

#: src/settings.ts:47
#. Name of a diagram style. "Joplin" is not translated.
msgid "Joplin light (light colours)"
msgstr "Joplin hell (helle Farben)"

#: src/settings.ts:49
#: src/settings.ts:61
msgid "Custom (preamble below)"
msgstr "Eigene (Präambel unten)"

#: src/settings.ts:57
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML dark (dark colours, default)"
msgstr "PlantUML dunkel (dunkle Farben, Standard)"

#: src/settings.ts:59
#. Name of a diagram style. "PlantUML" is not translated.
msgid "PlantUML standard (light colours)"
msgstr "PlantUML-Standard (helle Farben)"

#: src/settings.ts:81
msgid "Auto (follow Joplin's theme)"
msgstr "Automatisch (Joplins Design folgen)"

#: src/settings.ts:87
msgid "Diagram theme"
msgstr "Diagrammdesign"

#: src/settings.ts:88
msgid "Auto chooses the light or dark style from the background of the note viewer."
msgstr "Automatisch wählt den hellen oder dunklen Stil anhand des Hintergrunds der Notizansicht."

#: src/settings.ts:97
msgid "Style for the light theme"
msgstr "Stil für das helle Design"

#: src/settings.ts:98
msgid "Used on a light note viewer. Dark colours on a light page are hard to read."
msgstr "Wird bei heller Notizansicht verwendet. Dunkle Farben sind auf einer hellen Seite schwer zu lesen."

#: src/settings.ts:83
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Light"
msgstr "Hell"

#: src/settings.ts:85
#. A value of the setting "Diagram theme".
msgctxt "Diagram theme"
msgid "Dark"
msgstr "Dunkel"
